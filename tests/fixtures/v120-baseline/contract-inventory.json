      {
        "name": "status",
        "publicOptions": [
          "--run <id>"
        ],
        "sideEffect": "read-only status inspection"
      },
      {
        "name": "prompt",
        "publicOptions": [
          "--run <id>",
          "--stage <name>"
        ],
        "sideEffect": "read-only prompt rendering"
      },
      {
        "name": "list",
        "publicOptions": [],
        "sideEffect": "read-only run listing"
      },
      {
        "name": "mark",
        "publicOptions": [
          "--run <id>",
          "--stage <name>",
          "--state <state>",
          "--reason <text>"
        ],
        "sideEffect": "writes artifact-state.json"
      },
      {
        "name": "check",
        "publicOptions": [
          "--run <id>",
          "--artifact <path>",
          "--prompts",
          "--artifacts",
          "--all",
          "--trace",
          "--design-map",
          "--strict"
        ],
        "sideEffect": "reads run artifacts and may write check/trace results under the run"
      },
      {
        "name": "export",
        "publicOptions": [
          "--run <id>",
          "--out <path>"
        ],
        "sideEffect": "writes a bounded export only when a safe output path is supplied; otherwise prints it"
      }
